# ============================================
# PRICING ALGORITHM CONFIGURATION
# ============================================
# V1 (Original): Basic pricing logic with safety checks
# V2 (Advanced): Continuous confidence, DOS, CVaR, elasticity priors
# V3 (Production-Grade): Real learning, regret accounting, EVI, Pareto optimization

# Set USE_ALGORITHM_V3=true to enable V3 (requires database migration first!)
# Otherwise defaults to V2
USE_ALGORITHM_V3=true
USE_ALGORITHM_V2=true

# ============================================
# SHOPIFY DUAL-MODE AUTHENTICATION
# ============================================
# Set to "manual" for local dev or "oauth" for production
AUTH_MODE=oauth

# MANUAL MODE ONLY (for local development):
# Replace with your test store credentials
SHOP=
SHOPIFY_ACCESS_TOKEN=

# ============================================
# SHOPIFY OAUTH CONFIGURATION
# ============================================
# Get these from your Shopify Partner Dashboard
# https://partners.shopify.com/organizations
SHOPIFY_API_KEY=your_partner_app_key
SHOPIFY_API_SECRET=your_partner_app_secret
SHOPIFY_REDIRECT_URI=https://automerchant-backend-v2.vercel.app/api/shopify/callback
SHOPIFY_SCOPES=read_products,write_products,read_orders,write_inventory
